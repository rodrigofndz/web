---
import { useTranslations, getLang } from '../i18n/utils';
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang).contact;
---

<section id="contact" class="px-6 py-16 md:py-32">
  <div class="mx-auto max-w-5xl">
    <h2 class="mb-4 text-sm font-medium tracking-widest text-[--color-accent] uppercase">
      {t.label}
    </h2>
    <div class="grid gap-10 lg:gap-16 lg:grid-cols-2">
      <div>
        <p class="gradient-text mb-6 text-2xl font-bold tracking-tight md:text-3xl">
          {t.heading}
        </p>
        <p class="text-[--color-muted] leading-relaxed">
          {t.description}
        </p>
      </div>

      <form
        id="contact-form"
        class="flex flex-col gap-4"
        data-msg-sending={t.sending}
        data-msg-success={t.success}
        data-msg-error={t.error}
        data-btn-send={t.submit}
      >
        <!-- Honeypot — hidden from users, bots fill it; submissions with it set are dropped. -->
        <input
          type="text"
          name="company"
          id="company"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
          class="absolute -left-[9999px] h-0 w-0 opacity-0"
        />
        <div>
          <label for="name" class="mb-1.5 block text-xs font-medium tracking-wider text-[--color-accent]/80 uppercase">
            {t.name}
          </label>
          <input
            id="name"
            name="name"
            type="text"
            required
            class="w-full rounded-lg border border-[--color-border] bg-[--color-surface] px-4 py-3 text-sm text-[--color-text] outline-none transition-colors placeholder:text-[--color-muted]/50 focus:border-[--color-accent] focus:ring-1 focus:ring-[--color-accent]/30"
            placeholder={t.namePlaceholder}
          />
        </div>
        <div>
          <label for="email" class="mb-1.5 block text-xs font-medium tracking-wider text-[--color-accent]/80 uppercase">
            {t.email}
          </label>
          <input
            id="email"
            name="email"
            type="email"
            required
            class="w-full rounded-lg border border-[--color-border] bg-[--color-surface] px-4 py-3 text-sm text-[--color-text] outline-none transition-colors placeholder:text-[--color-muted]/50 focus:border-[--color-accent] focus:ring-1 focus:ring-[--color-accent]/30"
            placeholder={t.emailPlaceholder}
          />
        </div>
        <div>
          <p class="mb-2 text-xs font-medium tracking-wider text-[--color-accent]/80 uppercase">
            {t.serviceLabel}
          </p>
          <div class="flex flex-wrap gap-2" id="service-chips">
            {t.services.map((service) => (
              <button
                type="button"
                data-service={service}
                aria-pressed="false"
                class="service-chip rounded-full border border-[--color-border] bg-[--color-surface] px-3 py-1.5 text-xs font-medium text-[--color-muted] transition-all duration-200 hover:border-[--color-accent]/50 hover:text-[--color-text]"
              >
                {service}
              </button>
            ))}
          </div>
          <input type="hidden" name="service" id="service-value" />
        </div>
        <div>
          <label for="message" class="mb-1.5 block text-xs font-medium tracking-wider text-[--color-accent]/80 uppercase">
            {t.message}
          </label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            class="w-full resize-none rounded-lg border border-[--color-border] bg-[--color-surface] px-4 py-3 text-sm text-[--color-text] outline-none transition-colors placeholder:text-[--color-muted]/50 focus:border-[--color-accent] focus:ring-1 focus:ring-[--color-accent]/30"
            placeholder={t.messagePlaceholder}
          ></textarea>
        </div>

        <p id="form-status" class="hidden text-sm"></p>

        <button
          type="submit"
          class="submit-btn rounded-lg px-6 py-3 text-sm font-semibold"
        >
          {t.submit}
        </button>
      </form>
    </div>
  </div>
</section>

<style>
  .service-chip[data-selected='true'] {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }

  .submit-btn {
    background-color: var(--color-button);
    color: #ffffff;
    cursor: pointer;
    transition:
      background-color 0.18s ease,
      transform 0.1s ease,
      opacity 0.18s ease;
  }
  /* hover cue — darker fill */
  .submit-btn:hover:not(:disabled) {
    background-color: var(--color-button-hover);
  }
  /* click cue — darker still + quick press-in */
  .submit-btn:active:not(:disabled) {
    background-color: var(--color-button-active);
    transform: scale(0.97);
  }
  .submit-btn:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = document.getElementById('form-status') as HTMLParagraphElement;
  const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
  const serviceInput = document.getElementById('service-value') as HTMLInputElement;
  const chips = document.querySelectorAll<HTMLButtonElement>('.service-chip');

  const sending = form.dataset.msgSending ?? 'Sending...';
  const successMsg = form.dataset.msgSuccess ?? "Message sent!";
  const errorMsg = form.dataset.msgError ?? 'Something went wrong. Please try again.';
  const sendLabel = form.dataset.btnSend ?? 'Send message';

  // The success message auto-hides after this many ms.
  const SUCCESS_VISIBLE_MS = 5000;
  let hideTimer: ReturnType<typeof setTimeout> | undefined;

  // Chips are a multi-select toggle group — the hidden input holds the
  // selected services as a comma-separated list.
  const syncServices = () => {
    serviceInput.value = Array.from(chips)
      .filter((c) => c.dataset.selected === 'true')
      .map((c) => c.dataset.service ?? '')
      .join(', ');
  };

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const selected = chip.dataset.selected !== 'true';
      if (selected) chip.dataset.selected = 'true';
      else delete chip.dataset.selected;
      chip.setAttribute('aria-pressed', String(selected));
      syncServices();
    });
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    button.disabled = true;
    button.textContent = sending;
    status.className = 'hidden text-sm';
    clearTimeout(hideTimer);

    const service = serviceInput.value || undefined;
    const body = {
      name: (form.elements.namedItem('name') as HTMLInputElement).value,
      email: (form.elements.namedItem('email') as HTMLInputElement).value,
      ...(service && { service }),
      message: (form.elements.namedItem('message') as HTMLTextAreaElement).value,
      company: (form.elements.namedItem('company') as HTMLInputElement).value,
    };

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });

      if (res.ok) {
        status.textContent = successMsg;
        status.className = 'text-sm text-[--color-accent]';
        form.reset();
        chips.forEach((c) => {
          delete c.dataset.selected;
          c.setAttribute('aria-pressed', 'false');
        });
        serviceInput.value = '';
        // auto-hide the success message after a few seconds
        hideTimer = setTimeout(() => status.classList.add('hidden'), SUCCESS_VISIBLE_MS);
      } else {
        throw new Error('Server error');
      }
    } catch {
      status.textContent = errorMsg;
      status.className = 'text-sm text-red-400';
    } finally {
      button.disabled = false;
      button.textContent = sendLabel;
      status.classList.remove('hidden');
    }
  });
</script>
