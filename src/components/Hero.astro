---
import { useTranslations, getLang } from '../i18n/utils';
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang).hero;
---

<section class="relative flex min-h-screen flex-col items-center justify-center px-6 pt-20 text-center">
  <!-- Radial glow -->
  <div
    class="pointer-events-none absolute inset-0 -z-10 flex items-center justify-center overflow-hidden"
    aria-hidden="true"
  >
    <div class="h-[600px] w-[600px] rounded-full blur-3xl" style="background: var(--color-glow)"></div>
  </div>

  <p class="mb-4 rounded-full border border-[--color-border] bg-[--color-surface] px-4 py-1.5 text-xs font-medium tracking-widest text-[--color-accent] uppercase">
    {t.role}
  </p>
  <h1 id="hero-name" class="gradient-text mb-6 text-4xl font-bold tracking-tight sm:text-5xl lg:text-7xl">
    Rodrigo Fernández
  </h1>
  <p class="mb-10 max-w-xl text-base text-[--color-muted] leading-relaxed sm:text-lg">
    {t.tagline}
  </p>
  <div class="flex w-full flex-col items-center gap-3 sm:flex-row sm:justify-center sm:gap-4">
    <a
      href="#contact"
      class="w-full rounded-lg bg-[--color-accent] px-6 py-3 text-sm font-semibold text-[--color-accent-fg] transition-opacity hover:opacity-90 sm:w-auto"
    >
      {t.ctaPrimary}
    </a>
    <a
      href="#services"
      class="w-full rounded-lg border border-[--color-border] px-6 py-3 text-sm font-semibold text-[--color-text] transition-colors hover:border-[--color-accent] sm:w-auto"
    >
      {t.ctaSecondary}
    </a>
  </div>
</section>
