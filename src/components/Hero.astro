---
import { useTranslations, getLang } from '../i18n/utils';
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang).hero;
const labels = t.availability.labels;
---

<section class="relative flex min-h-screen flex-col items-center justify-center px-6 pt-20 text-center">
  <!-- Radial glow -->
  <div
    class="pointer-events-none absolute inset-0 -z-10 flex items-center justify-center"
    aria-hidden="true"
  >
    <div class="h-[600px] w-[600px] rounded-full blur-3xl" style="background: var(--color-glow)"></div>
  </div>

  <p class="mb-4 rounded-full border border-[--color-border] bg-[--color-surface] px-4 py-1.5 text-xs font-medium tracking-widest text-[--color-accent] uppercase">
    {t.role}
  </p>
  <h1 id="hero-name" class="gradient-text mb-6 text-4xl font-bold tracking-tight sm:text-5xl lg:text-7xl">
    Rodrigo Fernández
  </h1>
  <p class="mb-6 max-w-xl text-base text-[--color-muted] leading-relaxed sm:text-lg">
    {t.tagline}
  </p>

  <!-- Availability status — renders neutral, then a client fetch fills in the
       live status from /api/availability (KV-backed, updatable without a redeploy). -->
  <div
    id="availability-badge"
    class="mb-10 inline-flex max-w-full items-center gap-2 rounded-full px-4 py-1.5"
    style="background:rgba(156,163,175,0.08);border:1px solid rgba(156,163,175,0.2)"
    data-label-available={labels.available}
    data-label-busy={labels.busy}
    data-label-unavailable={labels.unavailable}
  >
    <span class="relative flex h-2 w-2 shrink-0">
      <span
        id="availability-ping"
        class="absolute inline-flex h-full w-full rounded-full opacity-60"
        style="background:#9ca3af"
      ></span>
      <span
        id="availability-dot"
        class="relative inline-flex h-2 w-2 rounded-full"
        style="background:#9ca3af"
      ></span>
    </span>
    <span id="availability-label" class="text-xs font-medium" style="color:#9ca3af">
      {labels.available}
    </span>
  </div>
  <div class="flex w-full flex-col items-center gap-3 sm:flex-row sm:justify-center sm:gap-4">
    <a
      href="#contact"
      class="w-full rounded-lg bg-[--color-accent] px-6 py-3 text-sm font-semibold text-[--color-accent-fg] transition-opacity hover:opacity-90 sm:w-auto"
    >
      {t.ctaPrimary}
    </a>
    <a
      href="#services"
      class="w-full rounded-lg border border-[--color-border] px-6 py-3 text-sm font-semibold text-[--color-text] transition-colors hover:border-[--color-accent] sm:w-auto"
    >
      {t.ctaSecondary}
    </a>
  </div>
</section>

<script>
  const COLORS = {
    available:   { dot: '#4ade80', bg: 'rgba(74,222,128,0.08)',  border: 'rgba(74,222,128,0.2)'  },
    busy:        { dot: '#fbbf24', bg: 'rgba(251,191,36,0.08)',  border: 'rgba(251,191,36,0.2)'  },
    unavailable: { dot: '#9ca3af', bg: 'rgba(156,163,175,0.08)', border: 'rgba(156,163,175,0.2)' },
  };
  type Status = keyof typeof COLORS;

  const badge = document.getElementById('availability-badge');
  const ping = document.getElementById('availability-ping');
  const dot = document.getElementById('availability-dot');
  const label = document.getElementById('availability-label');

  if (badge && ping && dot && label) {
    const apply = (status: Status) => {
      const c = COLORS[status];
      badge.style.background = c.bg;
      badge.style.border = `1px solid ${c.border}`;
      ping.style.background = c.dot;
      dot.style.background = c.dot;
      label.style.color = c.dot;
      label.textContent =
        badge.dataset[`label${status[0].toUpperCase()}${status.slice(1)}`] ?? label.textContent;
      // Only an active status pulses; unavailable stays static.
      ping.classList.toggle('animate-ping', status !== 'unavailable');
    };

    fetch('/api/availability')
      .then((r) => (r.ok ? r.json() : Promise.reject()))
      .then((d) => apply(d.status in COLORS ? d.status : 'unavailable'))
      .catch(() => apply('unavailable'));
  }
</script>
