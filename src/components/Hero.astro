---
import { useTranslations, getLang } from '../i18n/utils';
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang).hero;
const labels = t.availability.labels;

// Artificial delay (ms) before the availability fetch resolves, so the
// "loading" placeholder stays visible.
const REQUEST_DELAY_MS = 1000;

// How often (ms) an open page re-checks the availability status.
const POLL_INTERVAL_MS = 5 * 60 * 1000;
---

<section class="relative flex min-h-screen flex-col items-center justify-center px-6 pt-20 text-center">
  <!-- Radial glow -->
  <div
    class="pointer-events-none absolute inset-0 -z-10 flex items-center justify-center"
    aria-hidden="true"
  >
    <div class="h-[600px] w-[600px] rounded-full blur-3xl" style="background: var(--color-glow)"></div>
  </div>

  <p class="mb-4 rounded-full border border-[--color-border] bg-[--color-surface] px-4 py-1.5 text-xs font-medium tracking-widest text-[--color-accent] uppercase">
    {t.role}
  </p>
  <h1 id="hero-name" class="gradient-text mb-6 text-4xl font-bold tracking-tight sm:text-5xl lg:text-7xl">
    Rodrigo Fernández
  </h1>
  <p class="mb-6 max-w-xl text-base text-[--color-muted] leading-relaxed sm:text-lg">
    {t.tagline}
  </p>

  <!-- Availability status — renders a "loading" placeholder, then a client
       fetch fills in the live status from /api/availability (KV-backed). -->
  <div
    id="availability-badge"
    class="mb-10 inline-flex max-w-full items-center gap-2 rounded-full px-4 py-1.5"
    style="background:color-mix(in srgb, var(--badge-neutral) 8%, transparent);border:1px solid color-mix(in srgb, var(--badge-neutral) 20%, transparent)"
    data-delay={REQUEST_DELAY_MS}
    data-poll={POLL_INTERVAL_MS}
    data-label-available={labels.available}
    data-label-busy={labels.busy}
    data-label-unavailable={labels.unavailable}
    data-label-empty={labels.empty}
    data-label-notfound={labels.notfound}
    data-label-loading={labels.loading}
  >
    <span class="relative flex h-2 w-2 shrink-0">
      <span
        id="availability-ping"
        class="absolute inline-flex h-full w-full animate-ping rounded-full opacity-60"
        style="background:var(--badge-neutral)"
      ></span>
      <span
        id="availability-dot"
        class="relative inline-flex h-2 w-2 rounded-full"
        style="background:var(--badge-neutral)"
      ></span>
    </span>
    <span id="availability-label" class="text-xs font-medium" style="color:var(--badge-neutral)">
      {labels.loading}
    </span>
  </div>
  <div class="flex w-full flex-col items-center gap-3 sm:flex-row sm:justify-center sm:gap-4">
    <a
      href="#contact"
      class="w-full rounded-lg bg-[--color-accent] px-6 py-3 text-sm font-semibold text-[--color-accent-fg] transition-opacity hover:opacity-90 sm:w-auto"
    >
      {t.ctaPrimary}
    </a>
    <a
      href="#services"
      class="w-full rounded-lg border border-[--color-border] px-6 py-3 text-sm font-semibold text-[--color-text] transition-colors hover:border-[--color-accent] sm:w-auto"
    >
      {t.ctaSecondary}
    </a>
  </div>
</section>

<script>
  // Each state → a theme-aware CSS variable (defined per theme in global.css)
  // and whether the dot pulses.
  const COLORS = {
    available:   { color: 'var(--badge-available)',   pulse: true  },
    busy:        { color: 'var(--badge-busy)',        pulse: true  },
    unavailable: { color: 'var(--badge-unavailable)', pulse: false },
    empty:       { color: 'var(--badge-neutral)',     pulse: false },
    notfound:    { color: 'var(--badge-neutral)',     pulse: false },
    loading:     { color: 'var(--badge-neutral)',     pulse: true  },
  };
  type State = keyof typeof COLORS;

  // Statuses the API may legitimately return.
  const FROM_API: State[] = ['available', 'busy', 'unavailable', 'empty'];

  const badge = document.getElementById('availability-badge');
  const ping = document.getElementById('availability-ping');
  const dot = document.getElementById('availability-dot');
  const label = document.getElementById('availability-label');

  if (badge && ping && dot && label) {
    const delay = Number(badge.dataset.delay) || 0;
    const pollInterval = Number(badge.dataset.poll) || 0;

    const apply = (state: State) => {
      const { color, pulse } = COLORS[state];
      badge.style.background = `color-mix(in srgb, ${color} 8%, transparent)`;
      badge.style.border = `1px solid color-mix(in srgb, ${color} 20%, transparent)`;
      ping.style.background = color;
      dot.style.background = color;
      label.style.color = color;
      const key = `label${state[0].toUpperCase()}${state.slice(1)}`;
      label.textContent = badge.dataset[key] ?? label.textContent;
      ping.classList.toggle('animate-ping', pulse);
    };

    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

    // Fetch the current status and update the badge. On a background poll a
    // transient failure keeps the last known state instead of flipping to
    // the "notfound" message.
    const refresh = async (isPoll: boolean) => {
      try {
        const res = await fetch('/api/availability');
        if (!res.ok) throw new Error('bad response');
        const data = await res.json();
        apply(FROM_API.includes(data.status) ? data.status : 'empty');
      } catch {
        if (!isPoll) apply('notfound'); // couldn't reach the API
      }
    };

    (async () => {
      apply('loading');
      await wait(delay); // keeps the placeholder visible
      await refresh(false);
      // Re-check periodically so an open page picks up status changes.
      if (pollInterval > 0) setInterval(() => refresh(true), pollInterval);
    })();
  }
</script>
