---
import { useTranslations, getLang } from '../i18n/utils';
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang).about;

const stack = [
  { label: t.stack.languages, value: 'C#, TypeScript' },
  { label: t.stack.frontend, value: 'React, Astro, Blazor' },
  { label: t.stack.backend, value: 'ASP.NET, Node.js, REST' },
  { label: t.stack.infrastructure, value: 'Cloudflare, Azure, Google Cloud, Docker' },
];
---

<section id="about" class="relative px-6 py-16 md:py-32">
  <!-- Subtle background glow -->
  <div class="pointer-events-none absolute inset-0 -z-10 flex items-center overflow-hidden" aria-hidden="true">
    <div class="h-[400px] w-[400px] rounded-full blur-3xl" style="background: var(--color-glow); opacity: 0.5"></div>
  </div>

  <div class="mx-auto max-w-5xl">
    <h2 class="mb-4 text-sm font-medium tracking-widest text-[--color-accent] uppercase">
      {t.label}
    </h2>
    <div class="grid gap-10 lg:gap-16 lg:grid-cols-2">
      <div>
        <p class="gradient-text mb-6 text-2xl font-bold tracking-tight md:text-3xl">
          {t.heading}
        </p>
        <p class="mb-4 text-[--color-muted] leading-relaxed">
          {t.bio1}
        </p>
        <p class="text-[--color-muted] leading-relaxed">
          {t.bio2}
        </p>
      </div>
      <div class="flex flex-col gap-6">
        {stack.map(({ label, value }) => (
          <div class="border-l-2 border-[--color-accent] pl-4">
            <p class="mb-1 text-xs font-medium tracking-wider text-[--color-accent]/70 uppercase">{label}</p>
            <p class="text-sm text-[--color-text]">{value}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
