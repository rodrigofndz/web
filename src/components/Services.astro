---
import { useTranslations, getLang } from '../i18n/utils';
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang).services;

const icons = [
  `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14c0 1.66 4.03 3 9 3s9-1.34 9-3V5"/><path d="M3 12c0 1.66 4.03 3 9 3s9-1.34 9-3"/></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
];

const services = t.items.map((item, i) => ({ ...item, icon: icons[i] }));
---

<section id="services" class="relative px-6 py-16 md:py-32">
  <div class="pointer-events-none absolute inset-0 -z-10 flex justify-end" aria-hidden="true">
    <div class="h-[400px] w-[400px] rounded-full blur-3xl" style="background: var(--color-glow); opacity: 0.6"></div>
  </div>

  <div class="mx-auto max-w-5xl">
    <h2 class="mb-4 text-sm font-medium tracking-widest text-[--color-accent] uppercase">
      {t.label}
    </h2>
    <p class="gradient-text mb-10 text-2xl font-bold tracking-tight md:mb-16 md:text-3xl">
      {t.heading}
    </p>
    <div class="grid gap-px border border-[--color-border] bg-[--color-border] sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => (
        <div class="group relative bg-[--color-bg] p-6 transition-colors hover:bg-[--color-surface] md:p-8">
          <div class="absolute inset-x-0 top-0 h-px bg-[--color-accent] opacity-0 transition-opacity group-hover:opacity-100"></div>
          <div class="mb-4 w-fit rounded-lg border border-[--color-border] bg-[--color-surface] p-2 text-[--color-accent] transition-colors group-hover:border-[--color-accent]/40 group-hover:bg-[--color-accent]/10" set:html={service.icon} />
          <h3 class="mb-3 text-base font-semibold text-[--color-text] transition-colors group-hover:text-[--color-accent]">
            {service.title}
          </h3>
          <p class="text-sm leading-relaxed text-[--color-muted]">
            {service.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
